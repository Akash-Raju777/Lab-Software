# ==========================================================
# LabTrack Frontend Environment Variables (.env.example)
# Copy this file to .env.local and fill in your values
# ==========================================================

# Backend API Endpoint
# In local development: http://localhost:8080
# In production on Vercel: https://your-backend-api-domain.com
NEXT_PUBLIC_API_URL=http://localhost:8080

# Laboratory Branding
NEXT_PUBLIC_LAB_NAME=Microbiology Laboratory Services

# Supabase Credentials (from Supabase Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Supabase Server-Side Secrets
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
SUPABASE_SECRET_KEY=your-supabase-secret-key
SUPABASE_JWKS_URL=https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json
